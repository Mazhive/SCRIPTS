#!/bin/bash
# ensure-proton.sh — Poortwachter: checkt of er een Proton-runner is, en zo
# niet, vraagt (interactief of grafisch) of GE-Proton nu geïnstalleerd mag
# worden via install-proton.sh.
#
# Bedoeld om aangeroepen te worden door game-common.sh (game_launch), maar
# blijft een los, zelfstandig script zodat de toekomstige Python-GUI
# dependency-installaties ook zelf kan aansturen (rechtstreeks
# install-proton.sh, of deze gate voor de terminal/desktop-prompt-variant).
#
# Gebruik:
#   ensure-proton.sh                    → gebruikt PROTON_PIN uit env indien gezet
#   PROTON_PIN=GE-Proton11-7 ensure-proton.sh
#
# Exit-status:
#   0  → er is (nu) een Proton-runner beschikbaar
#   1  → gebruiker heeft geannuleerd, of installatie/detectie mislukte
#
# Detectiecontext:
#   - TTY aanwezig (terminal)         → tekstprompt [j/N]
#   - geen TTY, wel grafische sessie  → kdialog (KDE) → zenity → notify-send
#     (notify-send heeft geen keuze-knoppen; toont alleen de melding en faalt)
#   - geen van beide                  → faalt direct met instructietekst

set -u

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$_here/../game-core/game-common.sh" 2>/dev/null || {
  echo " [ensure-proton] FOUT: kan game-common.sh niet laden vanaf $_here/../game-core/" >&2
  exit 1
}

_ep_log()  { echo " [ensure-proton] $*"; }
_ep_fail() { echo " [ensure-proton] FOUT: $*" >&2; exit 1; }

# ── Al aanwezig? Dan niets te doen ────────────────────────────
if _detect_proton >/dev/null 2>&1; then
  _ep_log "Proton-runner al aanwezig, geen installatie nodig."
  exit 0
fi

GAME_LABEL="${GAME_NAME:-Deze game}"
MSG_TITLE="Proton ontbreekt"
MSG_BODY="$GAME_LABEL heeft Proton nodig om te starten, maar er is geen Proton-runner gevonden.

Wil je GE-Proton nu automatisch installeren?
(Kies je 'Nee', dan kan $GAME_LABEL niet starten.)"

_ep_ask() {
  # 0 = ja, 1 = nee/annuleren, 2 = geen enkele dialoogmethode beschikbaar
  if [ -t 0 ]; then
    _ep_log "$MSG_TITLE: $GAME_LABEL heeft Proton nodig maar die is niet gevonden."
    local reply
    read -r -p " [ensure-proton] GE-Proton nu installeren? [j/N] " reply
    case "$reply" in
      j|J|y|Y|ja|Ja|JA) return 0 ;;
      *) return 1 ;;
    esac
  fi

  if command -v kdialog >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    kdialog --title "$MSG_TITLE" --yesno "$MSG_BODY" && return 0 || return 1
  fi

  if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    zenity --question --title="$MSG_TITLE" --text="$MSG_BODY" --width=400 && return 0 || return 1
  fi

  if command -v notify-send >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    notify-send -u critical "$MSG_TITLE" "$GAME_LABEL heeft Proton nodig, maar kan niet interactief gevraagd worden. Start '$_here/install-proton.sh' handmatig."
    return 2
  fi

  return 2
}

_ep_ask
answer=$?

if [ "$answer" -eq 2 ]; then
  _ep_fail "Geen terminal en geen grafische dialoogtool (kdialog/zenity/notify-send) beschikbaar. Installeer Proton handmatig via: $_here/install-proton.sh"
fi

if [ "$answer" -ne 0 ]; then
  _ep_log "Installatie geannuleerd door gebruiker. $GAME_LABEL kan niet starten zonder Proton."
  exit 1
fi

_ep_log "Installatie gestart: $_here/install-proton.sh"
if ! "$_here/install-proton.sh" ${PROTON_PIN:+--pin "$PROTON_PIN"}; then
  _ep_fail "install-proton.sh is mislukt. Zie bovenstaande foutmelding."
fi

if _detect_proton >/dev/null 2>&1; then
  _ep_log "Installatie geslaagd, Proton-runner gevonden."
  exit 0
fi

_ep_fail "Na installatie nog steeds geen Proton-runner gevonden. Controleer $_here/install-proton.sh handmatig."
