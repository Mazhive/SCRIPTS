#!/bin/bash
# forza-horizon-5.sh — Forza Horizon 5 (ElAmigos Premium Edition) via Proton.
#
# D3D12-titel: plain-wine (AOW-recept) kent geen volwaardige D3D12-route;
# deze game draait via een Proton-runner met eigen vkd3d-proton/dxgi.
# Zelfde principe als cyberpunk2077.sh: lokale verse prefix, run via
# `proton waitforexitandrun`, standalone én non-Steam-fusie-capabel.
#
# Recept vastgesteld v.a. de ElAmigos v1.653.463-install (2026-09):
#   verse prefix (wineboot -i), Proton-runner met vkd3d-proton.
# Hooks die bij provision draaien volgen de ElAmigos-vereisten.

export GAME_NAME="Forza-Horizon-5"
export GAME_DIR="/mnt/VG_00/PUBLIC-LIBRARY/PRE-INSTALLED-GAMES/WINDOWSGAMES/Forza Horizon 5"
export GAME_EXE="$GAME_DIR/ForzaHorizon5.exe"
export PREFIX_ARCH="win64"
export SCRIPT_VERSION="1"
export CREATE_DESKTOP_SHORTCUT="1"
export GAME_LAUNCHER="$(readlink -f "$0")"

# Proton-runner (D3D12/vkd3d-proton); geen Proton runtime, geen Steam nodig.
export PROTON_ENABLED="1"
# GE-Proton gepint (cyberpunk-patroon + opzoekwerk): vkd3d-proton zit al in
# de runner (d3d12.dll naast d3d12core.dll in <runner>/files/lib/wine/...),
# dus géén handmatige DLL-plaatsing of winecfg "d3d12=native" nodig. Nieuwe
# Proton-updates geven gemelde crashers (illegal-instruction) bij FH5;
# oudere GE-runners draaien stabieler. Ontbreekt de gepinde runner → geen
# stille fallback naar een andere (garantie van game-common.sh).
export PROTON_PIN="GE-Proton11-7"
# Echte Steam-appid van Forza Horizon 5; nodig zodat ProtonFixes de game
# herkent (regex op cijfers in STEAM_COMPAT_DATA_PATH; naam bevat geen cijfers).
export STEAM_APPID="1551360"
# gamescope uit (Vooraf niet actief bevonden voor deze install).
export GAME_GAMESCOPE="0"

# Provision-hooks; vul aan n.a.v. eerste run-ervaring (deel van verbetercyclus).
PROVISION_HOOKS=()
PRE_LAUNCH_HOOKS=()

# shellcheck disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/../game-core/game-common.sh"
game_main "$@"